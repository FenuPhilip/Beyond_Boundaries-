# Python/Django .gitignore
# See https://github.com/github/gitignore/blob/main/Python.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Django
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
static_root/
.env
.env.*

# Staticfiles
/staticfiles/

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints

# Misc
*.log
*.tmp
*.swp
*.pyc
*.pyo
*.pyd
